<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>WandWarsMP</AssemblyName>
    <RootNamespace>WandWarsMP</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>0.2.0</Version>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Override per machine: dotnet build -p:GameDir="..." -->
    <GameDir Condition="'$(GameDir)' == ''">E:\Program Files (x86)\Steam\steamapps\common\Wand Wars</GameDir>
    <!-- Second game copy for running two instances on one PC (dev only). -->
    <ClientDir Condition="'$(ClientDir)' == ''">C:\dev\wandwars-client</ClientDir>
    <ManagedDir>$(GameDir)\WandWars_Data\Managed</ManagedDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepInExCore)\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCore)\0Harmony.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(ManagedDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="Assembly-CSharp-firstpass" HintPath="$(ManagedDir)\Assembly-CSharp-firstpass.dll" Private="false" />
  </ItemGroup>

  <!-- Copy built plugin into the game's BepInEx plugins folder -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(GameDir)\BepInEx')">
    <MakeDir Directories="$(GameDir)\BepInEx\plugins\WandWarsMP" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins\WandWarsMP" />
  </Target>

  <Target Name="DeployToClientCopy" AfterTargets="Build" Condition="Exists('$(ClientDir)\BepInEx')">
    <MakeDir Directories="$(ClientDir)\BepInEx\plugins\WandWarsMP" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ClientDir)\BepInEx\plugins\WandWarsMP" />
  </Target>

</Project>
